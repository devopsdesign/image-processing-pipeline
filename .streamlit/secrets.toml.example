# Copy to .streamlit/secrets.toml for local runs, or paste into the
# "Secrets" box of your Streamlit Community Cloud app. NEVER commit the real file.

AWS_REGION            = "us-east-1"
AWS_ACCESS_KEY_ID     = "AKIA................"
AWS_SECRET_ACCESS_KEY = "........................................"

INPUT_BUCKET   = "cloudsight-intake-input-000000000000"
OUTPUT_BUCKET  = "cloudsight-intake-output-000000000000"
DYNAMODB_TABLE = "cloudsight-intake-results"

# Cognito auth (terraform output cognito_user_pool_id / cognito_app_client_id)
COGNITO_USER_POOL_ID = "us-east-1_XXXXXXXXX"
COGNITO_CLIENT_ID    = "XXXXXXXXXXXXXXXXXXXXXXXXXX"

# Used only by the Power User "Escalate to doctor" manual-send button.
SES_FROM     = "you@example.com"
DOCTOR_EMAIL = "doctor@example.com"
